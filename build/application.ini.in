#endif
#filter substitution
#include @TOPOBJDIR@/buildid.h
#include @TOPOBJDIR@/source-repo.h
[App]
Vendor=@MOZ_APP_VENDOR@
Name=@MOZ_APP_BASENAME@
RemotingName=@MOZ_APP_REMOTINGNAME@
#ifdef MOZ_APP_DISPLAYNAME
CodeName=@MOZ_APP_DISPLAYNAME@
#endif
Version=@MOZ_APP_VERSION@
#ifdef MOZ_APP_PROFILE
Profile=@MOZ_APP_PROFILE@
#endif
BuildID=@MOZ_BUILDID@
#ifdef MOZ_SOURCE_REPO
SourceRepository=@MOZ_SOURCE_REPO@
#endif
#ifdef MOZ_SOURCE_STAMP
SourceStamp=@MOZ_SOURCE_STAMP@
#endif
ID=@MOZ_APP_ID@

[Gecko]
MinVersion=@GRE_MILESTONE@
MaxVersion=@GRE_MILESTONE@

[XRE]
#ifdef MOZ_PROFILE_MIGRATOR
EnableProfileMigrator=1
#endif

#if MOZ_CRASHREPORTER
[Crash Reporter]
Enabled=1
ServerURL=@MOZ_CRASHREPORTER_URL@/submit?id=@MOZ_APP_ID@&version=@MOZ_APP_VERSION@&buildid=@MOZ_BUILDID@
#endif

#if MOZ_UPDATER
[AppUpdate]
# FORK: upstream points this at aus5.mozilla.org with a path carrying
# %BUILD_ID%, %OS_VERSION% and %SYSTEM_CAPABILITIES%. Those vary per client, so
# that path space cannot be served as static files. This fork collapses the
# template to (target, channel), which is a handful of files served by the
# build server itself. The manifest always advertises the newest build;
# Firefox compares buildID/appVersion itself and ignores anything not newer.
#
# This URL is compiled into every build, so an install permanently asks the
# host it was built with. Changing it strands existing installs on the old
# host. It must stay byte-identical to FORK_UPDATE_SCHEME/FORK_UPDATE_HOST in
# tools/fork/config.sh; tools/fork/docker/build-loop.sh refuses to build if
# they disagree.
#
# Plain HTTP is deliberate: this is reached over a WireGuard tunnel, which
# already provides encryption and peer authentication, and MAR signature
# verification -- not TLS -- is what guarantees the integrity of what gets
# installed. Using HTTP avoids making updates depend on certificate renewal,
# and avoids the trap that Firefox validates against NSS's own trust store, so
# an internal CA would fail update checks with no visible error.
URL=http://CHANGEME.lan/updates/%BUILD_TARGET%/%CHANNEL%/update.xml
#endif
