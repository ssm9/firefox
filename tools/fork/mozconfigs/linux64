# Fork build configuration for linux64.
#
# Deliberately self-contained. It must not source anything under
# $topsrcdir/build: build/unix/mozconfig.linux chains through
# build/unix/mozconfig.unix to build/mozconfig.common, which sources
# build/mozconfig.automation and exports MOZ_AUTOMATION_MOZCONFIG=1. configure
# rejects that outside Mozilla automation with "Please don't use them"
# (build/moz.configure/init.configure:205).
#
# Those fragments also assume Taskcluster-only variables -- MOZ_FETCHES_DIR,
# UPLOAD_PATH -- and enable the clang static-analysis plugin, none of which
# apply here.

ac_add_options --enable-application=browser

# Use the toolchains mach bootstrap put in MOZBUILD_STATE_PATH, and fetch any
# that are missing rather than failing configure.
ac_add_options --enable-bootstrap

ac_add_options --enable-optimize
ac_add_options --disable-debug

# Firefox branding may not be used on modified builds.
ac_add_options --with-branding=browser/branding/unofficial

ac_add_options --enable-updater
ac_add_options --enable-update-channel=ssm9

# The updater rejects any MAR whose channel ID is not in the accepted list.
# These must match the MAR_CHANNEL_ID that tools/fork/make_mar.sh stamps in.
export MAR_CHANNEL_ID=ssm9
export ACCEPTED_MAR_CHANNEL_IDS=ssm9

# MAR signature verification is on by default and must stay that way: it is the
# only thing preventing a third party from serving updates to these builds.
# Do NOT add --enable-unverified-updates.

# Extensions are AMO-signed, but leaving enforcement off keeps locally built
# unsigned copies of the extension loadable during development.
MOZ_REQUIRE_SIGNING=

# Warm sccache is what makes release-to-release rebuilds tolerable on a single
# machine. Conditional so this mozconfig still works without it installed.
if command -v sccache > /dev/null 2>&1; then
  ac_add_options --with-ccache=sccache
fi

export MOZILLA_OFFICIAL=1
